# Gemini API 키 (Google AI Studio에서 발급)
GEMINI_API_KEY=your_gemini_api_key_here

# 카카오맵 API 키 (병원 검색용)
KAKAO_MAP_API_KEY=your_kakao_map_api_key_here

# OpenWeatherMap UV Index API 키 (자외선 지수 조회용, openweathermap.org 무료 티어)
UV_API_KEY=your_openweathermap_api_key_here

# 네이버 검색(쇼핑) API 키 (성분 추천 시 실제 화장품 완제품 링크 검색용, 선택)
# developers.naver.com > Application 등록 > "검색" API 선택 시 무료 발급
# 없으면 기존 범용 검색 링크(search.shopping.naver.com)로 대체된다.
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# 데이터베이스 (기본: SQLite)
DATABASE_URL=sqlite:///./skinscope.db